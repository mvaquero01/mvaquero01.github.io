---
// Barra superior mínima: aparece al bajar de la portada (en las páginas de
// proyecto se ve siempre). Solo lleva el nombre, que vuelve al inicio.
import { ruta, type Idioma } from '../i18n/utils';
import perfil from '../data/perfil.json';

interface Props { lang: Idioma; alternativa: string; inicio: boolean }
const { lang, inicio } = Astro.props;
---

<header class="topbar" data-topbar={inicio ? 'auto' : 'fijo'}>
  <a href={ruta(`/${lang}/`)} class="topbar__nombre titular">{perfil.nombre} {perfil.apellidos}</a>
</header>

<style>
  .topbar {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    padding: 14px var(--gutter);
    display: flex;
    pointer-events: none;
    background: linear-gradient(var(--bg) 30%, transparent);
    transition: opacity 0.5s var(--ease), transform 0.5s var(--ease);
  }
  .topbar[data-topbar='auto'] {
    opacity: 0;
    transform: translateY(-100%);
  }
  .topbar[data-topbar='auto'].is-visible {
    opacity: 1;
    transform: none;
  }
  .topbar__nombre {
    pointer-events: auto;
    font-size: 1.1rem;
    line-height: 1.2;
  }
</style>
