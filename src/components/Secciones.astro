---
// Todas las secciones de la página de inicio que van debajo de la portada:
// sobre mí, proyectos, experiencia, formación, habilidades y contacto.
// El contenido sale de src/data/*.json y de los proyectos en Markdown.
import type { CollectionEntry } from 'astro:content';
import { existsSync } from 'node:fs';
import { t, bi, ruta, seccionProyectos, type Idioma } from '../i18n/utils';
import perfil from '../data/perfil.json';
import experiencia from '../data/experiencia.json';
import formacion from '../data/formacion.json';
import habilidades from '../data/habilidades.json';
import premios from '../data/premios.json';

interface Props { lang: Idioma; proyectos: CollectionEntry<'proyectos'>[] }
const { lang, proyectos } = Astro.props;

const slug = (p: CollectionEntry<'proyectos'>) => p.id.split('/').slice(1).join('/');
// En la lista las imágenes son 4:3. Si junto a la portada hay una versión
// "portada-lista" (ya preparada en 4:3), se usa esa; si no, la portada normal.
const imagenLista = (portada: string) => {
  const lista = portada.replace(/portada\.(\w+)$/, 'portada-lista.$1');
  return lista !== portada && existsSync(`public${lista}`) ? lista : portada;
};
const periodo = (ini: string, fin: string | null) => (!ini ? '' : ini === fin ? ini : `${ini} — ${fin ?? t(lang, 'actual')}`);
const sitio = (...partes: string[]) => partes.filter(Boolean).join(' · ');
const iconosEntrada: Record<string, string> = {
  balon: 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18Zm0 4.5 3.3 2.4-1.3 3.9h-4l-1.3-3.9L12 7.5ZM12 3v4.5M15.3 9.9l4.4-1.6M14 13.8l2.6 3.9M10 13.8l-2.6 3.9M8.7 9.9 4.3 8.3',
  libro: 'M4 5.5C4 4.7 4.7 4 5.5 4H11v15H5.5C4.7 19 4 18.3 4 17.5v-12ZM20 5.5c0-.8-.7-1.5-1.5-1.5H13v15h5.5c.8 0 1.5-.7 1.5-1.5v-12Z',
  escuela: 'M3 10 12 5l9 5-9 5-9-5Zm3.5 2v4.5c1.5 1.7 9.5 1.7 11 0V12M21 10v5',
  camion: 'M3 7h11v9H3V7Zm11 3h4l3 3v3h-7v-6ZM7 18.5a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3Zm10 0a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3Z',
};
const iconos: Record<string, string> = {
  pin: 'M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21Zm0-9a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z',
  grad: 'M2 9l10-5 10 5-10 5L2 9Zm4 2.5V16c2 2 10 2 12 0v-4.5',
  work: 'M3 8h18v12H3V8Zm5 0V5h8v3M3 13h18',
  globe: 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Zm-9-9h18M12 3c3 3.5 3 14.5 0 18M12 3c-3 3.5-3 14.5 0 18',
};
---

<!-- ============ SOBRE MÍ ============ -->
<section id="sobre" class="section wrap">
  <div class="section__head">
    <span class="section__num">01</span>
    <h2 class="section__title split">{t(lang, 'sobre.titulo')}</h2>
  </div>
  <div class="sobre">
    {perfil.foto && (
      <figure class="sobre__foto" data-reveal="mask">
        <img src={ruta(perfil.foto)} alt={`${perfil.nombre} ${perfil.apellidos}`} loading="lazy" />
      </figure>
    )}
    <p class="sobre__lead titular" data-reveal>{bi(perfil.sobreMi, lang)[0]}</p>
    <div class="sobre__texto">
      {bi(perfil.sobreMi, lang).slice(1).map((p, i) => (
        <p data-reveal style={`--d:${i + 1}`}>{p}</p>
      ))}
    </div>
    <ul class="sobre__datos">
      {bi(perfil.datos, lang).map((d, i) => (
        <li data-reveal style={`--d:${i + 1}`}>
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d={iconos[d.icono]} fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round" /></svg>
          {d.texto}
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- ============ PROYECTOS ============ -->
<section id="proyectos" class="section wrap">
  <div class="section__head">
    <span class="section__num">02</span>
    <h2 class="section__title split">{t(lang, 'proyectos.titulo')}</h2>
    <p class="section__sub" data-reveal>{t(lang, 'proyectos.sub')}</p>
  </div>
  <ol class="lista-proyectos">
    {proyectos.map((p, i) => (
      <li data-reveal style={`--d:${i % 2}`}>
        <a class="proyecto" href={ruta(`/${lang}/${seccionProyectos[lang]}/${slug(p)}/`)}>
          <div class="proyecto__img">
            <img src={ruta(imagenLista(p.data.portada))} alt="" loading="lazy" decoding="async" />
          </div>
          <div class="proyecto__meta">
            <span class="proyecto__num">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="proyecto__titulo">{p.data.titulo}</h3>
            <span class="proyecto__fin"><span class="proyecto__anio">{p.data.fecha.slice(0, 4)}</span><span class="proyecto__flecha" aria-hidden="true">→</span></span>
          </div>
          <p class="proyecto__resumen">{p.data.resumen}</p>
          <ul class="proyecto__tags">
            {p.data.tecnologias.slice(0, 4).map((tec) => <li class="tag">{tec}</li>)}
          </ul>
        </a>
      </li>
    ))}
  </ol>
</section>

<!-- ============ EXPERIENCIA ============ -->
<section id="experiencia" class="section wrap">
  <div class="section__head">
    <span class="section__num">03</span>
    <h2 class="section__title split">{t(lang, 'experiencia.titulo')}</h2>
  </div>
  <ol class="linea">
    {experiencia.map((e, i) => (
      <li class="linea__item" data-reveal style={`--d:${i}`}>
        <div class="linea__lado">
          <span class="linea__fecha">{periodo(e.inicio, e.fin)}</span>
          <span class="linea__logo" aria-hidden="true">
            {e.logo
              ? <img src={ruta(e.logo)} alt="" loading="lazy" />
              : <svg viewBox="0 0 24 24" width="26" height="26"><path d={iconosEntrada[e.icono ?? 'libro']} fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round" /></svg>}
          </span>
        </div>
        <div>
          <h3 class="linea__titulo titular">{bi(e.puesto, lang)}</h3>
          <p class="linea__sitio">{sitio(typeof e.empresa === 'string' ? e.empresa : bi(e.empresa, lang), bi(e.lugar, lang))}</p>
          <ul class="linea__puntos">
            {bi(e.logros, lang).map((l) => <li>{l}</li>)}
          </ul>
          {e.tecnologias.length > 0 && (
            <ul class="proyecto__tags">{(lang === 'en' && e.tecnologiasEn ? e.tecnologiasEn : e.tecnologias).map((tec: string) => <li class="tag">{tec}</li>)}</ul>
          )}
        </div>
      </li>
    ))}
  </ol>
</section>

<!-- ============ FORMACIÓN ============ -->
<section id="formacion" class="section wrap">
  <div class="section__head">
    <span class="section__num">04</span>
    <h2 class="section__title split">{t(lang, 'formacion.titulo')}</h2>
  </div>
  <ol class="linea">
    {formacion.map((f, i) => (
      <li class="linea__item" data-reveal style={`--d:${i}`}>
        <div class="linea__lado">
          <span class="linea__fecha">{periodo(f.inicio, f.fin)}</span>
          <span class="linea__logo" aria-hidden="true">
            {f.logo
              ? <img src={ruta(f.logo)} alt="" loading="lazy" />
              : <svg viewBox="0 0 24 24" width="26" height="26"><path d={iconosEntrada[f.icono ?? 'libro']} fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round" /></svg>}
          </span>
        </div>
        <div>
          <h3 class="linea__titulo titular">{bi(f.titulo, lang)}</h3>
          <p class="linea__sitio">{f.centro} · {bi(f.lugar, lang)}</p>
          <ul class="linea__puntos">
            {bi(f.detalles, lang).map((l) => <li>{l}</li>)}
          </ul>
        </div>
      </li>
    ))}
  </ol>
</section>

<!-- ============ HABILIDADES ============ -->
<!-- ============ PREMIOS ============ -->
<section id="premios" class="section wrap">
  <div class="section__head">
    <span class="section__num">05</span>
    <h2 class="section__title split">{t(lang, 'premios.titulo')}</h2>
  </div>
  <ol class="linea">
    {premios.map((p, i) => (
      <li class="linea__item" data-reveal style={`--d:${i}`}>
        <div class="linea__lado">
          <span class="linea__fecha">{p.anio}</span>
          <span class="linea__logo" aria-hidden="true">
            {p.logo
              ? <img src={ruta(p.logo)} alt="" loading="lazy" />
              : <svg viewBox="0 0 24 24" width="26" height="26"><path d={iconosEntrada[p.icono ?? 'libro']} fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round" /></svg>}
          </span>
        </div>
        <div>
          <h3 class="linea__titulo titular">{bi(p.titulo, lang)}</h3>
          <p class="linea__sitio">{bi(p.entidad, lang)}</p>
          <ul class="linea__puntos">
            {bi(p.detalles, lang).map((l) => <li>{l}</li>)}
          </ul>
        </div>
      </li>
    ))}
  </ol>
</section>

<section id="habilidades" class="section wrap">
  <div class="section__head">
    <span class="section__num">06</span>
    <h2 class="section__title split">{t(lang, 'habilidades.titulo')}</h2>
  </div>
  <div class="habilidades">
    {habilidades.map((h, i) => (
      <div class="habilidades__grupo" data-reveal style={`--d:${i}`}>
        <h3 class="habilidades__nombre">{bi(h.grupo, lang)}</h3>
        <ul class="proyecto__tags">
          {(lang === 'en' && h.itemsEn ? h.itemsEn : h.items).map((s) => <li class="tag">{s}</li>)}
        </ul>
      </div>
    ))}
  </div>
</section>

<!-- ============ CONTACTO ============ -->
<section id="contacto" class="section wrap contacto">
  <p class="section__num" data-reveal>07 — {t(lang, 'nav.contacto')}</p>
  <h2 class="contacto__titulo split">{t(lang, 'contacto.titulo')}</h2>
  <p class="contacto__texto" data-reveal>{t(lang, 'contacto.texto')}</p>
  <a class="contacto__email titular" href={`mailto:${perfil.email}`} data-reveal>{perfil.email}</a>
  <div class="contacto__botones" data-reveal style="--d:1">
    <button class="btn" type="button" data-copiar={perfil.email} data-copiado={t(lang, 'contacto.copiado')}><span>{t(lang, 'contacto.copiar')}</span></button>
    <a class="btn" href={perfil.linkedin} target="_blank" rel="noopener">LinkedIn <span class="arrow" aria-hidden="true">↗</span></a>
    <a class="btn" href={perfil.github} target="_blank" rel="noopener">GitHub <span class="arrow" aria-hidden="true">↗</span></a>
    <a class="btn btn--solid" href={perfil.cv[lang]} download>{t(lang, 'hero.cv')} <span class="arrow" aria-hidden="true">↓</span></a>
  </div>
</section>

<footer class="pie wrap">
  <span>© {new Date().getFullYear()} {perfil.nombre} {perfil.apellidos}</span>
  <a class="link" href={`mailto:${perfil.email}`}>{perfil.email}</a>
</footer>

<style>
  /* Sobre mí */
  /* Sobre mí: la foto a la izquierda; a su lado, arriba, la frase principal a
     lo ancho, y debajo el texto y los datos con iconos en dos columnas.
     Así el texto no queda en una columna estrecha que baja mucho. */
  .sobre {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 280px;
    grid-template-areas: 'lead lead' 'texto datos';
    gap: 2rem clamp(32px, 5vw, 72px);
    align-items: start;
  }
  .sobre:has(.sobre__foto) {
    grid-template-columns: 300px minmax(0, 1fr) 280px;
    grid-template-areas: 'foto lead lead' 'foto texto datos';
  }
  .sobre__foto { grid-area: foto; margin: 0; aspect-ratio: 4 / 5; overflow: hidden; background: var(--bg-2); border-radius: 4px; }
  .sobre__foto img { width: 100%; height: 100%; object-fit: cover; }
  .sobre__lead { grid-area: lead; margin: 0; font-size: clamp(1.35rem, 2.2vw, 1.9rem); line-height: 1.25; color: var(--ink); max-width: 36ch; }
  .sobre__texto { grid-area: texto; }
  .sobre__texto p { margin: 0 0 1.1rem; color: var(--ink-2); max-width: 62ch; }
  .sobre__datos { grid-area: datos; }
  .sobre__datos { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .sobre__datos li {
    display: flex; gap: 0.75rem; align-items: center;
    padding: 0.9rem 0; border-bottom: 1px solid var(--line); font-size: 0.92rem;
  }
  .sobre__datos svg { flex: none; color: var(--accent); }

  /* Proyectos: dos columnas, la segunda desplazada hacia abajo */
  .lista-proyectos {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: 1fr 1fr; gap: clamp(40px, 6vw, 80px) clamp(20px, 4vw, 56px);
  }
  .lista-proyectos > li:nth-child(even) { transform: translateY(clamp(0px, 8vw, 120px)); }
  .js .lista-proyectos > li[data-reveal]:nth-child(even):not(.is-in) { transform: translateY(calc(clamp(0px, 8vw, 120px) + 28px)); }
  .proyecto { display: block; }
  .proyecto__img {
    aspect-ratio: 4 / 3; overflow: hidden; background: var(--bg-2);
    border-radius: 2px; position: relative;
  }
  .proyecto__img img {
    width: 100%; height: 100%; object-fit: cover;
    transition: transform 1.2s var(--ease), filter 0.6s;
  }
  .proyecto:hover .proyecto__img img { transform: scale(1.05); }
  .proyecto__meta {
    display: grid; grid-template-columns: auto 1fr auto; align-items: baseline;
    gap: 1rem; margin-top: 1rem; padding-bottom: 0.6rem; border-bottom: 1px solid var(--line);
    position: relative;
  }
  /* Al pasar por encima: la imagen hace zoom, el título se pone en color,
     una línea se dibuja debajo y el año deja paso a una flecha */
  .proyecto__meta::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: -1px; height: 2px;
    background: linear-gradient(var(--accent), var(--accent)) no-repeat left / 0% 100%;
    transition: background-size 0.6s var(--ease);
  }
  .proyecto__titulo { transition: color 0.35s; }
  .proyecto__fin { position: relative; display: inline-grid; justify-items: end; }
  /* Primero sale uno y después entra el otro, para que nunca coincidan */
  .proyecto__fin > * { grid-area: 1 / 1; transition: opacity 0.2s, transform 0.3s var(--ease); }
  .proyecto__anio { transition-delay: 0.2s; }
  .proyecto__flecha { font: 1.4rem/1 var(--head); color: var(--accent); opacity: 0; transform: translateX(-12px); align-self: center; }
  .proyecto:hover .proyecto__anio, .proyecto:focus-visible .proyecto__anio { transition-delay: 0s; }
  .proyecto:hover .proyecto__flecha, .proyecto:focus-visible .proyecto__flecha { transition-delay: 0.2s; }
  .proyecto:hover .proyecto__meta::after, .proyecto:focus-visible .proyecto__meta::after { background-size: 100% 100%; }
  .proyecto:hover .proyecto__titulo, .proyecto:focus-visible .proyecto__titulo { color: var(--accent); }
  .proyecto:hover .proyecto__anio, .proyecto:focus-visible .proyecto__anio { opacity: 0; transform: translateX(8px); }
  .proyecto:hover .proyecto__flecha, .proyecto:focus-visible .proyecto__flecha { opacity: 1; transform: none; }
  .proyecto__num, .proyecto__anio { font-family: var(--mono); font-weight: 500; font-size: 0.78rem; color: var(--ink-3); font-variant-numeric: tabular-nums; }
  .proyecto__titulo { font-size: clamp(1.5rem, 2.4vw, 2rem); }
  .proyecto__resumen { color: var(--ink-2); margin: 0.8rem 0; font-size: 0.95rem; }
  .proyecto__tags { list-style: none; display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 0; padding: 0; }

  /* Experiencia y formación */
  .linea { list-style: none; margin: 0; padding: 0; }
  .linea__item {
    display: grid; grid-template-columns: 220px 1fr; gap: 1rem 2rem;
    padding: 2rem 0; border-top: 1px solid var(--line); position: relative;
  }
  .linea__item::before {
    content: ''; position: absolute; left: 0; right: 0; top: -1px; height: 1px;
    background: linear-gradient(var(--accent), var(--accent)) no-repeat left / 0% 100%;
    transition: background-size 1.4s var(--ease) 0.2s;
  }
  .linea__item.is-in::before,
  html:not(.js) .linea__item::before { background-size: 100% 100%; }
  /* Logo de la empresa o del centro: en una ficha blanca del mismo tamaño
     para todos, debajo de la fecha (así el título no se mueve) */
  .linea__lado { display: flex; flex-direction: column; align-items: flex-start; gap: 0.9rem; }
  .linea__logo {
    flex: none; width: 104px; height: 56px; border-radius: 8px; background: #fff;
    display: grid; place-items: center; padding: 8px 10px; box-shadow: var(--shadow);
    color: var(--navy); overflow: hidden;
  }
  .linea__logo img { width: 100%; height: 100%; min-height: 0; object-fit: contain; }

  .linea__fecha { font-family: var(--mono); font-weight: 500; font-size: 0.8rem; color: var(--ink-3); font-variant-numeric: tabular-nums; padding-top: 0.5rem; }
  .linea__titulo { font-size: clamp(1.6rem, 3vw, 2.4rem); }
  .linea__sitio { margin: 0.3rem 0 0.8rem; color: var(--ink-2); font-weight: 500; font-size: 0.95rem; }
  .linea__puntos { margin: 0 0 1rem; padding-left: 1.1rem; color: var(--ink-2); }
  .linea__puntos li { margin-bottom: 0.3rem; }

  /* Habilidades */
  .habilidades { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 2.5rem 2rem; }
  .habilidades__nombre {
    font-family: var(--mono); font-size: 0.85rem; font-weight: 600;
    color: var(--ink-3); margin-bottom: 1rem;
  }

  /* Contacto */
  .contacto { text-align: center; padding-bottom: clamp(100px, 14vw, 180px); }
  .contacto__titulo { font-size: clamp(3rem, 11vw, 9rem); line-height: 0.95; margin: 1rem 0 1.5rem; }
  .contacto__texto { color: var(--ink-2); max-width: 52ch; margin: 0 auto 2rem; }
  .contacto__email {
    display: inline-block; font-size: clamp(1.4rem, 4vw, 2.6rem); margin-bottom: 2.2rem;
    background: linear-gradient(currentColor, currentColor) left bottom / 0% 1px no-repeat;
    transition: background-size 0.6s var(--ease);
    overflow-wrap: anywhere;
  }
  .contacto__email:hover { background-size: 100% 1px; }
  .contacto__botones { display: flex; flex-wrap: wrap; gap: 0.6rem; justify-content: center; }

  .pie {
    display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap;
    padding-block: 1.5rem 110px; border-top: 1px solid var(--line);
    font-size: 0.8rem; color: var(--ink-3);
  }

  @media (max-width: 860px) {
    .sobre, .sobre:has(.sobre__foto) { grid-template-columns: 1fr; grid-template-areas: 'foto' 'lead' 'texto' 'datos'; }
    .sobre__foto { max-width: 320px; }
    .lista-proyectos { grid-template-columns: 1fr; }
    .lista-proyectos > li:nth-child(even),
    .js .lista-proyectos > li[data-reveal]:nth-child(even).is-in { transform: none; }
    .linea__item { grid-template-columns: 1fr; gap: 0.25rem; }
    .linea__lado { flex-direction: row; align-items: center; justify-content: space-between; }
    .linea__logo { width: 76px; height: 44px; padding: 6px 8px; }
    .linea__fecha { padding-top: 0; }
  }
</style>
